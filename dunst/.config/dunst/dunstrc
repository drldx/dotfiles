[global]
    monitor = 0
    follow = mouse
    width = 300
    offset = 10x10
    origin = top-right
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    alignment = left
    transparency = 10
    frame_color = "#89b4fa"
    separator_color = frame
    padding = 10
    horizontal_padding = 10
    corner_radius = 10
    gap_size = 10
    word_wrap = yes
    icon_position = left
    max_icon_size = 48
    idle_threshold = 120

[urgency_low]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 8

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
