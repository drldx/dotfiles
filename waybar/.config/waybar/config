{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "height": 30,
    "spacing": 4,
    "modules-left": [
	      "clock",
        "sway/mode",
        "sway/workspaces",
    ],

    "modules-center": [
    ],

    "modules-right": [
        "custom/net_speed",
        "custom/pomodoro",
        "backlight",
        "pulseaudio",
        "cpu",
        "memory",
        "battery",
        "network",
    ],
    "sway/workspaces": {
        "format": "{name}",
        "all-outputs": true,
        "format-icons": {
            "active": "",
            "default": "",
            "urgent": ""
        }
    },
    "sway/window": {
        "format": "{title}",
        "max-length": 30,
        "rewrite": {
          "(.*) — Mozilla Firefox": "  $1",
          "(.*) - Visual Studio Code": "󰨞  $1"
        }
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"]
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " Muted",
        "format-icons": {
            "default": [
            "", "", ""]
        },
    },
    "network": {
        "interval": 1,
        "format-wifi": "  {essid}",
        "format-ethernet": "{ifname} ↓ {bandwidthDownBits} ↑ {bandwidthUpBits}",
        "format-disconnected": "Disconnected",
        "tooltip-format": "{ifname}\nIP: {ipaddr}\nDown: {bandwidthDownBits}\nUp: {bandwidthUpBits}"
    },
    
    "custom/net_speed": {
        "exec": "~/.config/waybar/net_speed.sh",
        "interval": 1
    },

    "custom/pomodoro": {
    "exec": "~/.config/waybar/scripts/pomodoro.sh print",
    "return-type": "json",
    "signal": 8,
    "interval": "once",
    "on-click": "~/.config/waybar/scripts/pomodoro.sh toggle",
    "on-click-right": "~/.config/waybar/scripts/pomodoro.sh reset"
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 1
    },
    "memory": {
        "format": " {percentage}%",
        "interval": 1
    },
    "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", ""],
    "states": {
        "critical": 15,
        "warning": 30,
        "good": 80
        }
    },

    "clock": {
        "format":"󰃭 {:%a %d %b | %I:%M %p }", 
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 10
    }
}
