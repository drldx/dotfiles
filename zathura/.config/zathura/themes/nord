# Nord theme – optimized for long reading

set default-bg              "#2e3440"
set default-fg              "#d8dee9"

set statusbar-bg            "#2e3440"
set statusbar-fg            "#d8dee9"

set inputbar-bg             "#2e3440"
set inputbar-fg             "#d8dee9"

set notification-bg         "#2e3440"
set notification-fg         "#d8dee9"
set notification-error-bg   "#3b4252"
set notification-error-fg   "#bf616a"
set notification-warning-bg "#3b4252"
set notification-warning-fg "#ebcb8b"

set completion-bg           "#2e3440"
set completion-fg           "#d8dee9"
set completion-highlight-bg "#3b4252"
set completion-highlight-fg "#eceff4"

# The important part for PDFs
set recolor                 true
set recolor-keephue         false

set recolor-lightcolor      "#2e3440"
set recolor-darkcolor       "#d8dee9"

# Comfort tweaks
set smooth-scroll           true
set page-padding            5

